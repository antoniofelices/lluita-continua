---
import { useTranslations } from '@i18n/utils';
import type { LangType } from '@i18n/ui';

const lang = (Astro.currentLocale ?? 'ca') as LangType;
const t = useTranslations(lang);
---

<footer class="border-t border-black/10 mt-24 py-8">
	<div class="container flex justify-between items-center">
		<p class="text-xs! text-m-gray-500 uppercase tracking-widest mb-0">{t('footerCopyright')}</p>
		<a
			href="#top"
			class="text-xs text-m-gray-500 uppercase tracking-widest hover:text-black transition-colors border-none!"
		>
			{t('footerScrollTop')}
		</a>
	</div>
</footer>

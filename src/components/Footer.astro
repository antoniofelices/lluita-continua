---
import { t } from '@i18n/index.ts';
import {ArrowUp} from '@lucide/astro'
---

<footer class="border-t border-black/10 mt-24 py-8">
	<div class="container flex justify-between items-center font-heading">
		<p class="text-xs! text-m-gray-500 uppercase tracking-widest mb-0">{t.footer.copyright}</p>
		<a
			href="#top"
			class="text-xs text-m-gray-500 uppercase tracking-widest hover:text-black transition-colors border-none! inline-flex gap-2 items-center"
		>
			<ArrowUp size={12}/> {t.footer.scrollTop}
		</a>
	</div>
</footer>

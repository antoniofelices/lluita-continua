---
import { otherLang, siteUrls, slugToAltSlug } from '@i18n/index.ts'

const currentSlug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const altSlug = slugToAltSlug[currentSlug] ?? '';
const altPath = altSlug ? `/${altSlug}` : '/';

const href = `${siteUrls[otherLang]}${altPath}`;
---

<nav class="flex items-center ml-3">
	<ul class="flex gap-x-2 m-0">
		<li>
			<a
				href={href}
				class="font-heading text-xs uppercase tracking-widest hover:text-m-red-500 transition-colors border-none!"
			>
				{otherLang === 'ca' ? 'CAT' : 'CAST'}
			</a>
		</li>
	</ul>
</nav>

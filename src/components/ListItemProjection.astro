---
import { ArrowRight } from '@lucide/astro';
import type { Projection } from '@types/projections';
import { useTranslations } from '@i18n/utils';
import type { LangType } from '@i18n/ui';

type Props = Projection;

const { date, place, city, description, link } = Astro.props;
const t = useTranslations((Astro.currentLocale ?? 'ca') as LangType);
---

<li>
	<span class="text-m-gray-500 font-heading text-xs">{date}</span><br/>
	<span>{place}{place && city ? ', ' : ''}{city}</span>
	{description &&
		<>
		<br/>
		<span class="text-m-gray-500 text-sm">{description}</span>
		</>
	}
	{link &&
		<>
		<br/>
		<a href={link} target="_blank" rel="noopener noreferrer" class="text-sm inline-flex gap-2 items-center"><span>{t('moreInfo')}</span><ArrowRight size={12}/></a>
	</>}
</li>

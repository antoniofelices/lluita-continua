---
import { useTranslations, useTranslatedPath } from '@i18n/utils';
import type { LangType } from '@i18n/ui';

const lang = (Astro.currentLocale ?? 'ca') as LangType;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang, Astro.currentLocale);

const currentPath = Astro.url.pathname;

const navItems = [
	{ key: 'projections', label: t('navProjections') },
	{ key: 'materials', label: t('navMaterials') },
	{ key: 'press', label: t('navPress') },
	{ key: 'directing', label: t('navDirecting') },
] as const;
---

<nav>
	<ul class="flex flex-col lg:flex-row gap-6 lg:gap-0">
		{navItems.map(({ key, label }) => {
			const href = translatePath(`/${key}`);
			const isActive = currentPath.includes(key) || currentPath.includes((translatePath(`/${key}`)));
			return (
				<li>
					<a
						href={href}
						class:list={[
							"font-heading text-2xl lg:text-xs uppercase tracking-widest border-none! px-0 lg:px-3 transition-colors",
							isActive ? "text-m-red-500" : "hover:text-m-red-500"
						]}
					>
						{label}
					</a>
				</li>
			);
		})}
	</ul>
</nav>

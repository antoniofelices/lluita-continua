---
import { t } from '@i18n/index.ts';

const currentPath = Astro.url.pathname;

const navItems = [
	{ label: t.nav.projections.label, href: t.nav.projections.href },
	{ label: t.nav.materials.label, href: t.nav.materials.href },
	{ label: t.nav.press.label, href: t.nav.press.href },
	{ label: t.nav.directing.label, href: t.nav.directing.href },
];
---

<nav>
	<ul class="flex flex-col lg:flex-row gap-6 lg:gap-0 m-0">
		{navItems.map(({ label, href }) => {
			const isActive = currentPath === href || currentPath.startsWith(href + '/');
			return (
				<li>
					<a
						href={href}
						class:list={[
							"font-heading text-2xl lg:text-xs uppercase tracking-widest border-none! px-0 lg:px-3 transition-colors",
							isActive ? "text-m-red-500" : "hover:text-m-red-500"
						]}
					>
						{label}
					</a>
				</li>
			);
		})}
	</ul>
</nav>

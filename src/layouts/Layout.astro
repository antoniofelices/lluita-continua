---
import { ClientRouter } from 'astro:transitions';
import { languages, hreflangMap, ogLocales, siteUrls, routes } from '@i18n/ui';
import type { LangType } from '@i18n/ui';
import { useTranslations, getRouteFromUrl } from '@i18n/utils';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/fonts.css';
import '@styles/global.css';

interface Props {
	title: string
	description?: string
	ogImage?: string
}

const { props, site, url } = Astro;

const {
	title,
	description,
	ogImage,
} = props;

const lang = (Astro.currentLocale ?? 'ca') as LangType;
const t = useTranslations(lang);
const routeKey = getRouteFromUrl(url, Astro.currentLocale);
const canonicalUrl = new URL(url.pathname, site);
const siteName = t('title');
const ogLocale = ogLocales[lang];

const alternateLinks = (Object.keys(languages) as LangType[]).map((l) => {
	const otherRoutes = routes[l] ?? {};
	const path = routeKey && routeKey in otherRoutes ? `/${otherRoutes[routeKey]}` : '/';
	return {
		hreflang: hreflangMap[l],
		href: `${siteUrls[l]}${path}`,
	};
});
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl.href} />
		{alternateLinks.map(({ hreflang, href }) => (
			<link rel="alternate" hreflang={hreflang} href={href} />
		))}
		<title>{title}</title>
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:site_name" content={siteName} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<ClientRouter />
	</head>
	<body id="top">
		<Header />
		<slot />
		<Footer />
	</body>
</html>

---
import { ClientRouter } from 'astro:transitions';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { t, lang, otherLang, siteUrls, hreflangMap, ogLocales, slugToAltSlug } from '@i18n/index.ts';
import '@styles/fonts.css';
import '@styles/global.css';

interface Props {
	title: string
	description?: string
	ogImage?: string
	slug?: string
}

const { title, description, ogImage, slug } = Astro.props;

const currentPath = !slug || slug === 'home' ? '/' : `/${slug}`;
const altSlug = slug ? (slugToAltSlug[slug] ?? '') : '';
const altPath = !altSlug || altSlug === 'home' ? '/' : `/${altSlug}`;

const canonicalUrl = `${siteUrls[lang]}${currentPath}`;
const alternateLinks = [
	{ hreflang: hreflangMap[lang], href: `${siteUrls[lang]}${currentPath}` },
	{ hreflang: hreflangMap[otherLang], href: `${siteUrls[otherLang]}${altPath}` },
];

const ogLocale = ogLocales[lang];
const siteName = t.title;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		{alternateLinks.map(({ hreflang, href }) => (
			<link rel="alternate" hreflang={hreflang} href={href} />
		))}
		<title>{title}</title>
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={siteName} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<ClientRouter />
	</head>
	<body id="top">
		<Header />
		<slot />
		<Footer />
	</body>
</html>

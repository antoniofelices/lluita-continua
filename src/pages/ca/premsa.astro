---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import saramago from '@assets/images/saramago.jpg';
---

<Layout title="Premsa — I la Lluita Continua" description="Cobertura mediàtica del documental I la Lluita Continua.">
	<main class="container py-16 pt-20">
		<h1 class="font-heading text-5xl md:text-7xl font-bold mb-16">Premsa</h1>

		<div class="grid md:grid-cols-3 gap-12">
			<div class="md:col-span-2">
				<ul class="space-y-8">
					<li class="border-b border-black/10 pb-8">
						<span class="font-heading text-xs uppercase tracking-widest text-m-gray-500 block mb-2">2021</span>
						<p class="font-body text-xl mb-0">
							Proposta didàctica per a alumnes de 4t d'ESO elaborada per Ramon Breu a
							<a href="http://cinescola.info/" target="_blank" rel="noopener noreferrer">cinescola.info</a>
						</p>
					</li>
					<li class="border-b border-black/10 pb-8">
						<span class="font-heading text-xs uppercase tracking-widest text-m-gray-500 block mb-2">21 desembre 2019</span>
						<p class="font-body text-xl mb-1">
							<em>L'Informatiu</em> — TVE Catalunya
						</p>
						<p class="font-body text-sm text-m-gray-500 mb-0">
							Reportatge al programa informatiu de TVE Catalunya
						</p>
					</li>
					<li class="border-b border-black/10 pb-8">
						<span class="font-heading text-xs uppercase tracking-widest text-m-gray-500 block mb-2">27 novembre 2019</span>
						<p class="font-body text-xl mb-1">
							<em>En Directe</em> — Ràdio 4
						</p>
						<p class="font-body text-sm text-m-gray-500 mb-0">
							La periodista Llúcia Oliva presenta el seu darrer documental sobre els treballadors del camp i la construcció de Catalunya
						</p>
					</li>
					<li class="border-b border-black/10 pb-8">
						<span class="font-heading text-xs uppercase tracking-widest text-m-gray-500 block mb-2">26 novembre 2019</span>
						<p class="font-body text-xl mb-1">
							<em>Territori clandestí</em> — Ràdio 4
						</p>
						<p class="font-body text-sm text-m-gray-500 mb-0">
							Programa dedicat al documental i a la lluita dels obrers antifranquistes
						</p>
					</li>
					<li class="border-b border-black/10 pb-8">
						<span class="font-heading text-xs uppercase tracking-widest text-m-gray-500 block mb-2">14 novembre 2019</span>
						<p class="font-body text-xl mb-1">
							<em>Els Matins</em> — TV3
						</p>
						<p class="font-body text-sm text-m-gray-500 mb-0">
							La lluita social i política dels obrers de la construcció als anys 70
						</p>
					</li>
				</ul>
			</div>
			<div class="md:col-span-1">
				<Image
					src={saramago}
					alt="Imatge de premsa"
					class="w-full object-cover"
				/>
			</div>
		</div>
	</main>
</Layout>

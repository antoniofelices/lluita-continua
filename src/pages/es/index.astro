---
import Layout from '@layouts/Layout.astro';
import { useTranslations } from '@i18n/utils';
import type { LangType } from '@i18n/ui';
import teaserVideo from '@assets/videos/teaser-la-lucha-continua.mp4';

const lang = (Astro.currentLocale ?? 'es') as LangType;
const t = useTranslations(lang);
---

<Layout title={t('title')} description={t('description')}>
	<main>
		<section class="bg-black">
			<div class="container py-20 pt-24">
				<h1 class="font-heading text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-3 leading-none">
					Y la Lucha Continua
				</h1>
				<p class="text-m-gray-500 font-heading text-sm uppercase tracking-widest mb-10">
					Del campo a la construcción de Cataluña
				</p>
				<video
					class="w-full max-w-3xl aspect-video bg-black"
					controls
					preload="metadata"
					src={teaserVideo}
				></video>
			</div>
		</section>

		<section class="container py-16">
			<div class="max-w-2xl">
				<p class="mb-10">
					Un <strong>documental sobre los obreros antifranquistas</strong> que organizaron las grandes huelgas de la construcción mientras se batían por la libertad y la autonomía de Cataluña.
				</p>

				<h2 class="font-heading text-xs uppercase tracking-widest text-m-gray-500 mb-5 mt-12">{t('credits')}</h2>
				<ul class="space-y-2 mb-10">
					<li><span class="text-m-gray-500">Dirección y guión:</span> Llúcia Oliva</li>
					<li><span class="text-m-gray-500">Cámara:</span> Carlos Ortiz, Marina Palomo</li>
					<li><span class="text-m-gray-500">Montaje:</span> Jaume Vidal</li>
					<li><span class="text-m-gray-500">Fotografías:</span> Pilar Aymerich</li>
					<li><span class="text-m-gray-500">Diseño gráfico:</span> Pilar Villuendas, Alícia Gómez Villuendas</li>
					<li><span class="text-m-gray-500">Coordinación:</span> Bibiana Bigorra</li>
					<li><span class="text-m-gray-500">Producción:</span> Adela d'Alòs-Moner, Josep M. Rodriguez Rovira</li>
				</ul>

				<a
					href="http://hdl.handle.net/11703/129107"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block font-heading text-xs uppercase tracking-widest border border-black px-6 py-3 hover:bg-black hover:text-white transition-colors no-underline! border-solid!"
				>
					{t('watchFull')}
				</a>
			</div>
		</section>
	</main>
</Layout>

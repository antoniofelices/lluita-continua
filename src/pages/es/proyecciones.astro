---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import { projectionsES, cancelledProjectionsES } from '@data/projections.es';
import ListItemProjection from '@components/ListItemProjection.astro';
import img1 from '@assets/images/IMG_20191127_191423_resized_20191218_042936362.jpg';
import img2 from '@assets/images/aguilas_2023.jpg';
import img3 from '@assets/images/2023_badalona-2.jpg';
import img4 from '@assets/images/Madrid_12_05_2021-1.jpg';
import img5 from '@assets/images/Esparraguera_2020-1.jpg';
---

<Layout title="Proyecciones — Y la Lucha Continua" description="Proyecciones del documental Y la Lucha Continua. Del campo a la construcción de Cataluña.">
	<main class="container py-16 pt-20">
		<h1 class="font-heading text-5xl md:text-7xl font-bold mb-16">Proyecciones</h1>

		<div class="max-w-2xl">
			<section class="mb-14">
				<h2 class="font-heading text-xs uppercase tracking-widest text-m-red-500 mb-6">Programadas</h2>
				<p>Duración: 1 hora</p>
				<p>
					Para solicitar una proyección, contactad con
					<a href="mailto:info@lluitacontinua.cat">info@lluitacontinua.cat</a>
				</p>
			</section>

			<section class="mb-14">
				<h2 class="font-heading text-xs uppercase tracking-widest text-m-red-500 mb-6">Realizadas</h2>
				<ul class="space-y-3">
					{projectionsES.map((item) => (
						<ListItemProjection {...item} />
					))}
				</ul>
			</section>

			<section class="mb-14">
				<h2 class="font-heading text-xs uppercase tracking-widest text-m-red-500 mb-6">
					Proyecciones canceladas por pandemia COVID
				</h2>
				<ul class="space-y-3">
					{cancelledProjectionsES.map(({ date, city }) => (
						<li>
							<span class="text-m-gray-500 font-heading text-xs">{date}</span><br/>
							{city}
						</li>
					))}
				</ul>
			</section>

			<p class="mt-8">
				Recordamos que podéis ver el documental íntegro (1 hora) en:
				<a href="http://hdl.handle.net/11703/128845" target="_blank" rel="noopener noreferrer">
					hdl.handle.net/11703/128845
				</a>
			</p>
		</div>

		<section class="mt-16">
			<h2 class="font-heading text-xs uppercase tracking-widest text-m-red-500 mb-6">
				Algunas imágenes de proyecciones
			</h2>
			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
				<Image src={img1} alt="Proyección noviembre 2019" class="w-full aspect-square object-cover" />
				<Image src={img2} alt="Proyección Águilas 2023" class="w-full aspect-square object-cover" />
				<Image src={img3} alt="Proyección Badalona 2023" class="w-full aspect-square object-cover" />
				<Image src={img4} alt="Proyección Madrid 2021" class="w-full aspect-square object-cover" />
				<Image src={img5} alt="Proyección Esparraguera 2020" class="w-full aspect-square object-cover" />
			</div>
		</section>
	</main>
</Layout>

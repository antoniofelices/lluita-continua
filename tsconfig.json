{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@data/*": ["./src/data/*"],
      "@projectTypes/*": ["./src/types/*"],
      "@components/*": ["./src/components/*"],
      "@content/*": ["./src/content/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@styles/*": ["./src/styles/*"],
      "@lib/*": ["./src/lib/*"]
    }
  }
}
